# Blanks between two neighbouring tokens (syntax: crates/core-format/src/spacing.rs); the first row
# that matches decides, the last row says yes.
[space]
parent=MarkerAnnotation|Annotation / text=... : yes
text=; / text=;|)&parent=ForSpec : yes
* / text=;|,|)|]|.|::|... : no
text=(|[|.|::|@ / * : no
text=) / text=( : yes
parent=MarkerAnnotation|Annotation / text=[ : yes
* / text=[ : no
* / text=<> : no
# Angle brackets of type arguments and type parameters (the other `<` and `>` compare).
kind!=Identifier / kind=Lt&parent=TypeParameters : yes
* / kind=Lt|Gt&parent=TypeArguments|TypeParameters : no
kind=Lt&parent=TypeArguments|TypeParameters / * : no
kind=Gt&parent=TypeArguments|TypeParameters&grand=MethodInvocation|ExplicitConstructorInvocation / * : no
kind=Gt&parent=TypeArguments|TypeParameters / text=( : no
kind=Gt&parent=TypeArguments|TypeParameters / * : yes
text=<> / text={ : yes
text=<> / * : no
kind=Identifier / text=( : no
text=this|super / text=( : no
* / text=( : yes
text={ / text={ : no
* / text={ : yes
* / text=:&parent=ForSpec|TernaryExpression|AssertStatement : yes
* / text=: : no
* / text=} : no
text={ / * : no
* / * : yes

# A blank line between two members unless both are fields without a doc comment or annotation
# arguments (syntax: crates/core-format/src/blank.rs).
[blank]
kind!=FieldDeclaration|ConstantDeclaration / *
* / kind!=FieldDeclaration|ConstantDeclaration
* / * : doc=yes
* / * : prev.doc=yes
* / * : annotated=args
* / * : prev.annotation_args=yes

# A `;` that ends nothing: between members, after a class, among the statements of a block.
[rewrite]
kind=Semi&parent=Program|TopLevelDeclaration|ClassBody|InterfaceBody|AnnotationTypeBody|RecordBody|Block|ConstructorBody : replace ""

# The order of the modifier keywords (JLS, the Java Language Specification; google-java-format).
[modifier-order]
order = public protected private abstract default static sealed non-sealed final transient volatile synchronized native strictfp
