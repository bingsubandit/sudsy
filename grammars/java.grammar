// Java (up to 25: records, sealed types, switch patterns, text blocks), parsed by rezel-lang-java (a Lezer grammar port) behind crates/lang-java/src/adapter.rs; a node kind is a row named like rezel's node, tokens are rezel's leaves.
// Format: see crates/core-syntax/src/grammar/mod.rs. Bodies are loose: they name the parts, not every order.

language java 23 "Java"
roles
rule boolean-literal-comparison level warn
// Binary operators, loosest first: `precedence <level> <assoc> "op"...` (core_syntax::Assoc).
precedence 1 left "||"
precedence 2 left "&&"
precedence 3 left "|"
precedence 4 left "^"
precedence 5 left "&"
precedence 6 left "==" "!="
precedence 7 left "<" ">" "<=" ">=" "instanceof"
precedence 8 left "<<" ">>" ">>>"
precedence 9 left "+" "-"
precedence 10 left "*" "/" "%"
comments line "//" block "/*" "*/"
trivia Comment line "//" block "/*" "*/"
suppress disable-next-line "sudsy-disable-next-line"
suppress disable-line "sudsy-disable-line"
suppress disable "sudsy-disable"
suppress enable "sudsy-enable"
suppress disable-file "sudsy-disable-file"
suppress ignore "sudsy-ignore"

token Whitespace #trivia #whitespace
token Newline #trivia #newline
// `//`, `/* */` and `/** */` comments.
token Comment #trivia #comment #indentable

// Reserved and contextual keywords, `this`, `super`, `var`, `void` and `@interface`.
token Keyword #type-token
// `int`, `boolean`, ...
token PrimitiveType #type-token
// A name (a declaration's too).
token Identifier #operand #type-token
// A string or a text block: one token.
token String #literal #string #operand
// A text block (`"""`) may span lines; a string may not.
string String quote "\"" triple escape "\\" line unknown invalid surrogates
  map "b" 8 "t" 9 "n" 10 "f" 12 "r" 13 "s" 32 "\"" 34 "'" 39 octal 3 hex "u" 4
token Char #literal #operand #string
string Char quote "'" escape "\\" line unknown invalid surrogates
  map "b" 8 "t" 9 "n" 10 "f" 12 "r" 13 "s" 32 "\"" 34 "'" 39 octal 3 hex "u" 4
// Integer and floating-point literals of every base.
token Number #literal #operand
token Boolean #literal #operand
token Null #literal #operand

token LBrace "{" #punctuation
token RBrace "}" #punctuation
token LParen "(" #punctuation #glue
token RParen ")" #punctuation #close
token LBracket "[" #punctuation #glue
token RBracket "]" #punctuation
token Lt "<" #punctuation #operator
token Gt ">" #punctuation #operator
token Semi ";" #punctuation #stray
token Comma "," #punctuation #separator #glue
token Dot "." #punctuation
token Colon ":" #punctuation
token ColonColon "::" #punctuation
token Arrow "->" #punctuation
token At "@" #punctuation
token Ellipsis "..." #punctuation
token Question "?" #punctuation
token Assign "=" #punctuation #operator
// Every other operator, assignment operators included.
token Operator #punctuation #operator

token Eof
token Unknown #error

node Program #opaque = items:#child* Eof
node AnnotatedType #child #type #opaque = #child*
node Annotation #child #annotation #opaque = #child*
node AnnotationArgumentList #child #opaque #annotation-arguments = #child*
node AnnotationTypeBody #child #block = LBrace items:#member* RBrace
node AnnotationTypeDeclaration #child #member #opaque = #child*
node AnnotationTypeDeclarationCore #child #wrapper #type-declaration #declaration #scope = Keyword name:Identifier members:AnnotationTypeBody
node AnnotationTypeElementDeclaration #child #member #opaque = #child*
node ArgumentList #child #opaque #arguments = #child*
node ArrayAccess #child #expression #index = object:#expression? object_token=object:#operand? LBracket arguments:#expression? arguments_token=arguments:#operand? RBracket
node ArrayCreationExpression #child #expression #opaque = #child*
node ArrayCreationType #child #opaque = #child*
node ArrayInitializer #child #expression #opaque #huggable = #child*
node ArrayType #child #type #opaque = #child*
node AssertStatement #child #statement #opaque = #child*
node AssignmentExpression #child #expression #assignment = left:#expression? left_token=left:#operand? operator:#operator right:#expression? right_token=right:#operand?
node BinaryExpression #child #expression #binary-chain #binary = left:#expression? left_token=left:#operand? operator:#operator right:#expression? right_token=right:#operand?
node Block #child #statement #member #block #scope = LBrace items:#statement* RBrace
node BreakStatement #child #statement #break = Keyword label:Label? Semi?
node CastExpression #child #expression #opaque = #child*
node CatchAlternativeType #child #opaque = #child*
node CatchClause #child #scope #catch = Keyword parameter:CatchFormalParameter body:Block
node CatchFormalParameter #child #opaque = #child*
node CatchType #child #opaque = #child*
node ClassBody #child #block = LBrace items:#member* RBrace
node ClassDeclaration #child #member #opaque = #child*
node ClassDeclarationCore #child #wrapper #type-declaration #declaration #scope = Keyword name:Identifier TypeParameters? Superclass? SuperInterfaces? Permits? members:ClassBody
node ClassLiteral #child #expression #opaque = #child*
node CompactConstructorDeclaration #child #member #opaque = #child*
node CompilationUnit #child #wrapper #scope #block = items:#child*
node ConstantDeclaration #child #member #opaque = #child*
node ConstructorBody #child #block = LBrace items:#statement* RBrace
node ConstructorDeclaration #child #member #declaration #function #scope = Modifiers? TypeParameters? name:Identifier parameters:FormalParameters Throws? body:ConstructorBody
node ContinueStatement #child #statement #continue = Keyword label:Label? Semi?
node CreatedClassType #child #opaque = #child*
node DefaultValue #child #opaque = #child*
node DimExpr #child #opaque = #child*
node Dimension #child #opaque = #child*
node DoStatement #child #statement #loop = Keyword body:#statement Keyword condition:ParenthesizedExpression Semi?
node ElementValueArrayInitializer #child #opaque #huggable = #child*
node ElementValuePair #child #opaque = #child*
node EnhancedForStatement #child #statement #scope #loop = Keyword ForSpec body:#statement
node EnumBody #child #block = LBrace items:#member* RBrace
node EnumBodyDeclarations #child #member #opaque #enum-tail = #child*
node EnumConstant #child #member #opaque #enum-constant = #child*
node EnumDeclaration #child #member #opaque = #child*
node EnumDeclarationCore #child #wrapper #type-declaration #declaration #scope = Keyword name:Identifier SuperInterfaces? members:EnumBody
node ExceptionType #child #opaque = #child*
node ExplicitConstructorInvocation #child #statement #opaque = #child*
node ExpressionStatement #child #statement #expression-statement = expression:#expression? expression_token=expression:#operand? Semi?
node ExtendsInterfaces #child #opaque #heritage = #child*
node FieldAccess #child #expression #member-access = object:#expression? object_token=object:#operand? Dot member:Identifier? this_member=member:ThisExpression?
node FieldDeclaration #child #member #declaration = Modifiers? #annotation* #type-token? #type? declarators:VariableDeclarator* Semi
node FinallyClause #child #statements = Keyword items:Block
node ForCondition #child #opaque = #child*
node ForInitializer #child #opaque = #child*
node ForSpec #child #opaque = #child*
node ForStatement #child #statement #scope #loop = Keyword ForSpec body:#statement
node ForUpdate #child #opaque = #child*
node FormalParameter #child #parameter #opaque = #child*
node FormalParameters #child #parameter-list = LParen parameters:#parameter* RParen
node GenericType #child #type #opaque = #child*
node Guard #child #opaque = #child*
node IfStatement #child #statement #conditional = Keyword condition:ParenthesizedExpression then:#statement Keyword? else:#statement?
node ImportDeclaration #child #opaque = #child*
node InferredLocalType #child #opaque = #child*
node InferredParameters #child #parameter-list = LParen? parameters:Identifier* RParen?
node InstanceofExpression #child #expression #opaque = #child*
node InstanceofPattern #child #opaque = #child*
node InterfaceBody #child #block = LBrace items:#member* RBrace
node InterfaceDeclaration #child #member #opaque = #child*
node InterfaceDeclarationCore #child #wrapper #type-declaration #declaration #scope = Keyword name:Identifier TypeParameters? ExtendsInterfaces? Permits? members:InterfaceBody
node InterfaceTypeList #child #opaque = #child*
node Label #child #opaque = #child*
node LabeledStatement #child #statement #labeled = label:Label Colon body:#statement
node LambdaExpression #child #expression #function #huggable-function #scope = parameters:#parameter-list? single=parameters:Identifier? Arrow body:Block? expression_body:#expression? expression_token=expression_body:#operand?
node LambdaFormalParameters #child #parameter-list = LParen? parameters:#parameter* RParen?
node LocalTypeDeclaration #child #statement #opaque = #child*
node LocalTypeModifiers #child #opaque = #child*
node LocalVariableDeclaration #child #statement #opaque = #child*
node LocalVariableDeclarationCore #child #wrapper #declaration = Modifiers? #annotation* #type-token? #type? InferredLocalType? declarators:VariableDeclarator*
node MarkerAnnotation #child #annotation #opaque = #child*
// `new` creates no regex in Java; `Pattern` is a static factory.
regex-call flavor java concat "+" "Pattern.compile" "Pattern.matches"
node MethodDeclaration #child #member #declaration #function #scope = Modifiers? TypeParameters? #annotation* #type-token? #type? name:Identifier parameters:FormalParameters Dimension* Throws? body:Block? DefaultValue? Semi?
node MethodInvocation #child #expression #call = object:#expression? object_token=object:#operand? Dot? TypeArguments? callee:MethodName arguments:ArgumentList
node MethodName #child #opaque = #child*
node MethodReference #child #expression #opaque = #child*
node MethodReferenceName #child #opaque = #child*
node Modifiers #child #opaque #modifiers = #child*
node ModuleBody #child #opaque = #child*
node ModuleDeclaration #child #opaque = #child*
node ModuleDirective #child #opaque = #child*
node ObjectCreationExpression #child #expression #call = object:#expression? object_token=object:#operand? Dot? Keyword TypeArguments? callee:CreatedClassType arguments:ArgumentList ClassBody?
node PackageDeclaration #child #opaque = #child*
node ParenthesizedExpression #child #expression #opaque = #child*
node PatternNode #child #opaque = #child*
node PatternVariable #child #opaque = #child*
node Permits #child #opaque #heritage = #child*
node QualifiedSuperExpression #child #expression #opaque = #child*
node ReceiverParameter #child #parameter #opaque = #child*
node RecordBody #child #block = LBrace items:#member* RBrace
node RecordComponent #child #opaque = #child*
node RecordDeclaration #child #member #opaque = #child*
node RecordDeclarationCore #child #wrapper #type-declaration #declaration #scope = Keyword name:Identifier TypeParameters? RecordHeader SuperInterfaces? members:RecordBody
node RecordHeader #child #opaque = #child*
node Resource #child #opaque = #child*
node ResourceSpecification #child #opaque = #child*
node ReturnStatement #child #statement #return = Keyword value:#expression? value_token=value:#operand? Semi?
node ScopedIdentifier #child #expression #opaque = #child*
node ScopedTypeName #child #type #opaque = #child*
node SpreadParameter #child #parameter #opaque = #child*
node StatementExpression #child #wrapper #expression #opaque = #child*
node StaticInitializer #child #member #opaque = #child*
node SuperExpression #child #expression #opaque = #child*
node SuperInterfaces #child #opaque #heritage = #child*
node Superclass #child #opaque #heritage = #child*
node SwitchBlockStatementGroup #child #case = test:SwitchLabel Colon body:SwitchBlockStatementGroupBody?
node SwitchBlockStatementGroupBody #child #wrapper #statements = items:SwitchGroupStatements
node SwitchCaseElement #child #opaque = #child*
node SwitchCaseLabelRest #child #opaque = #child*
node SwitchExpression #child #expression #opaque = #child*
node SwitchExpressionBlock #child #opaque = #child*
node SwitchExpressionRule #child #opaque = #child*
node SwitchGroupStatements #child #wrapper #statements = items:#statement*
node SwitchLabel #child #opaque = #child*
node SwitchStatement #child #statement #scope #switch #fallthrough = Keyword subject:ParenthesizedExpression cases=block:SwitchStatementBlock
node SwitchStatementBlock #child #opaque = #child*
node SwitchStatementRule #child #opaque = #child*
node SynchronizedStatement #child #statement #statements = Keyword ParenthesizedExpression items:Block
node TernaryExpression #child #expression #conditional = condition:#expression? condition_token=condition:#operand? Operator then:#expression? then_token=then:#operand? Colon else:#expression? else_token=else:#operand?
node ThisExpression #child #expression #opaque = #child*
node ThrowStatement #child #statement #throw = Keyword value:#expression? value_token=value:#operand? Semi?
node Throws #child #opaque = #child*
node TopLevelDeclaration #child #wrapper #opaque = #child*
node TryStatement #child #statement #try = Keyword body:Block catches:CatchClause* finally:FinallyClause?
node TryWithResourcesStatement #child #statement #scope #try = Keyword ResourceSpecification body:Block catches:CatchClause* finally:FinallyClause?
node TypeArguments #child #opaque = #child*
node TypeBound #child #opaque = #child*
node TypeName #child #opaque = #child*
node TypeOrStaticImportDeclaration #child #wrapper #import = Keyword Keyword? path:ScopedIdentifier Dot? Operator? Semi
node TypeParameter #child #opaque = #child*
node TypeParameters #child #opaque = #child*
node UnaryExpression #child #expression #unary = operator:#operator operand:#expression? operand_token=operand:#operand?
node UnitBeforeFirstMethod #child #wrapper #opaque = #child*
node UnnamedCompilationUnit #child #wrapper #opaque = #child*
node UpdateExpression #child #expression #unary = prefix=operator:#operator? operand:#expression? operand_token=operand:#operand? postfix=operator:#operator?
node VariableDeclarator #child #declaration = name:Identifier Dimension* Assign? init:#expression? init_token=init:#operand?
node WhileStatement #child #statement #loop = Keyword condition:ParenthesizedExpression body:#statement
node Wildcard #child #type #opaque = #child*
node YieldStatement #child #statement #opaque = #child*
