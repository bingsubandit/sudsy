// Gradle build scripts (Groovy DSL, `*.gradle`), parsed by tree-sitter (the fork grammars/tree-sitter-groovy of dekobon-tree-sitter-groovy) and mapped by the mapping of crates/lang-gradle/lang.yaml.
// Format: see crates/core-syntax/src/grammar/mod.rs.
// A string is one token however many `${}` it holds; the nodes are the ones the layout rows read.

language gradle 30 "Gradle"
comments line "//" block "/*" "*/"
rule no-empty-block
rule no-floating-version floating "^\\w+\\s*\\(?\\s*[\\x22\\x27][^\\x22\\x27\\s:]+:[^\\x22\\x27\\s:]+:([^\\x22\\x27\\s:]*\\+|latest\\.(release|integration))(:[^\\x22\\x27\\s:]+)?[\\x22\\x27]"
suppress disable-next-line "sudsy-disable-next-line"
suppress disable-line "sudsy-disable-line"
suppress disable "sudsy-disable"
suppress enable "sudsy-enable"
suppress disable-file "sudsy-disable-file"
suppress ignore "sudsy-ignore"

token Whitespace #trivia #whitespace
token Newline #trivia #newline
// `//`, `/* */`, `/** */` and a `#!` first line.
token Comment #trivia #comment

// A name: a variable, a method, a property, a type.
token Ident #operand #head
// Reserved words (`def`, `if`, `class`, `in`, `instanceof`, `as`, ...).
token Keyword #head
token Boolean #literal #operand
token Null #literal #operand
token Number #literal #operand
// A string of any kind (quoted, triple, slashy, dollar-slashy), delimiters and interpolations included.
token String #literal #string #operand
// The operators of expressions: `+ - * / % ** ! ~ == != < > <= >= <=> && || & | ^ << >> ++ -- =~ ==~ ?: ..` and the others.
token Op
// `=` and the compound assignments.
token Assign
token Comma ","
token Semi ";"
token Colon ":"
// `.`, `?.`, `*.`, `.&`, `.@`, `::`.
token Dot
token Arrow "->"
// `?` of a ternary.
token Quest "?"
// `( [ {` and `?[`, and their closers.
token Open #punctuation
token Close #punctuation
// Text the grammar has no token for.
token Text

token Eof
token Unknown #error

node Document #scope
node Closure #scope #function = Open ClosureParameters? body:#statement* Close
node ClosureParameters
node Block #block #scope = Open items:#statement* Close
node ClassBody
node EnumBody
node SwitchBlock
node ArgumentList
node ListLiteral
node MapLiteral
node MapEntry
node NamedArgument
node CommandChain #statement #expression-statement
node ParenthesizedExpression
node FormalParameters
node BinaryExpression
node UnaryExpression
node TernaryExpression
node ElvisExpression
node RangeExpression
node SpreadArguments
node SwitchCase
node ImportDeclaration #opaque
node LocalVariableDeclaration #statement #opaque
node VariableDeclarator #opaque
node IfStatement #statement #conditional #opaque
node TryStatement #statement #try #opaque
node CatchClause #catch #opaque
node AssertStatement #statement #assert #opaque
node ReturnStatement #statement #return #opaque
node ThrowStatement #statement #throw #opaque
node BreakStatement #statement #break #opaque
node ContinueStatement #statement #continue #opaque
node ExpressionStatement #statement #expression-statement #opaque
node MethodDeclaration #function #scope = heads:#head* FormalParameters body:Block
node MethodInvocation
node AssignmentExpression
node FieldAccess
