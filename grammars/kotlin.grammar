// Kotlin (.kt, .kts), parsed by ktrs-parser (crates/lang-kotlin/src/adapter.rs), a port of the Kotlin compiler's PSI parser.
// Node kinds are the compiler's PSI element types (`KtNodeTypes`, Pascal case) and punctuation tokens its `KtTokens`; every keyword, hard or soft, is `Keyword`. KDoc comments are `Comment` trivia like the others.
// Format: see crates/core-syntax/src/grammar/mod.rs.

language kotlin 22 "Kotlin"
roles
operators coalesce "?:"
comments line "//" block "/*" "*/"
suppress disable-next-line "sudsy-disable-next-line"
suppress disable-line "sudsy-disable-line"
suppress disable "sudsy-disable"
suppress enable "sudsy-enable"
suppress disable-file "sudsy-disable-file"
suppress ignore "sudsy-ignore"
suppress ignore-start "sudsy-ignore-start"
suppress ignore-end "sudsy-ignore-end"

token Whitespace #trivia #whitespace
token Newline #trivia #newline
// `//`, `/* */` (nested), `/** */` and a `#!` first line.
token Comment #trivia #comment #indentable-doc
token Lbracket "[" #punctuation
token Rbracket "]" #punctuation
token Lbrace "{" #punctuation
token Rbrace "}" #punctuation
token Lpar "(" #punctuation
token Rpar ")" #punctuation
token Dot "." #punctuation
token PlusPlus "++" #punctuation
token MinusMinus "--" #punctuation
token Mul "*" #punctuation
token Plus "+" #punctuation
token Minus "-" #punctuation
token Excl "!" #punctuation
token Div "/" #punctuation
token Perc "%" #punctuation
token Lt "<" #punctuation
token Gt ">" #punctuation
token LtEq "<=" #punctuation
token GtEq ">=" #punctuation
token EqEqEq "===" #punctuation
token Arrow "->" #punctuation
token DoubleArrow "=>" #punctuation
token ExclEqEqEq "!==" #punctuation
token EqEq "==" #punctuation
token ExclEq "!=" #punctuation
token ExclExcl "!!" #punctuation
token AndAnd "&&" #punctuation
token And "&" #punctuation
token OrOr "||" #punctuation
token SafeAccess "?." #punctuation
token Elvis "?:" #punctuation
token Quest "?" #punctuation
token ColonColon "::" #punctuation
token Colon ":" #punctuation
token Semicolon ";" #punctuation #separator
token DoubleSemicolon ";;" #punctuation
token Range ".." #punctuation
token RangeUntil "..<" #punctuation
token Eq "=" #punctuation
token MulEq "*=" #punctuation
token DivEq "/=" #punctuation
token PercEq "%=" #punctuation
token PlusEq "+=" #punctuation
token MinusEq "-=" #punctuation
token Hash "#" #punctuation
token At "@" #punctuation
token Comma "," #punctuation #separator

// Hard and soft keywords and modifiers (`fun`, `val`, `in`, `!is`, `as?`, `data`, ...).
token Keyword #keyword
token Identifier
token Integer #restyle
token Float #restyle
token Character
// A string is `StringTemplate`: its quotes, text parts, escapes and `$` / `${` entries.
token OpenQuote #string
token ClosingQuote #string
token StringPart #string
token EscapeSequence #string
// The `$` run of a multi-dollar string.
token InterpolationPrefix #string
token ShortTemplateEntryStart #string
token LongTemplateEntryStart #string
token LongTemplateEntryEnd "}" #string
// Zero-width end-of-file token; it carries the leading trivia of the file's tail.
token EndOfFile
// Text the parser could not classify.
token Unknown #error

node KtFile #scope
node Class #expression #item #declaration #type-declaration #scope =
    ModifierList? Keyword* name:Identifier? TypeParameterList? PrimaryConstructor? Colon? SuperTypeList? Keyword? TypeConstraintList? members:ClassBody?
node Fun #expression #item #declaration #function #scope =
    ModifierList? Keyword TypeParameterList? TypeReference? Dot? TypeParameterList? name:Identifier? TypeParameterList? parameters:ValueParameterList Colon? TypeReference? Keyword? TypeConstraintList? Keyword? ContractEffectList? Keyword? TypeConstraintList? body:Block? Eq? expression_body:#expression?
node Property #item #declaration =
    ModifierList? Keyword TypeParameterList? TypeReference? Dot? name:Identifier? Colon? TypeReference? Keyword? TypeConstraintList? Eq? #expression? PropertyDelegate? BackingField? PropertyAccessor*
node DestructuringDeclaration #item #opaque
node DestructuringDeclarationEntry #opaque
node ObjectDeclaration #item #declaration #type-declaration #scope =
    ModifierList? Keyword* name:Identifier? TypeParameterList? PrimaryConstructor? Colon? SuperTypeList? members:ClassBody?
node Typealias #item #declaration =
    ModifierList? Keyword name:Identifier TypeParameterList? Eq TypeReference
node CompanionBlock #item #opaque
node EnumEntry #item #opaque
node ClassInitializer #item #opaque
node ScriptInitializer #item #opaque
node SecondaryConstructor #item #function #scope =
    ModifierList? Keyword parameters:ValueParameterList Colon? ConstructorDelegationCall? ConstructorDelegationReference? body:Block?
node PrimaryConstructor #opaque
node ContextReceiver #opaque
node ContextParameterList #opaque
node TypeParameterList #opaque
node TypeParameter #declaration =
    ModifierList? name:Identifier Colon? TypeReference?
node SuperTypeList #opaque
node DelegatedSuperTypeEntry #opaque
node SuperTypeCallEntry #opaque
node SuperTypeEntry #opaque
node PropertyDelegate #opaque
node ConstructorCallee #opaque
node ValueParameterList #parameter-list =
    Lpar? parameters:ValueParameter* Rpar?
node ValueParameter #declaration =
    ModifierList? Keyword? name:Identifier? DestructuringDeclaration? Colon? TypeReference? Eq? #expression?
node ClassBody #block =
    Lbrace items:#item* Rbrace
node ImportList #opaque
node FileAnnotationList #opaque
node ImportDirective #import =
    Keyword path:#expression Dot? Mul? ImportAlias?
node ImportAlias #opaque
node ModifierList #modifiers #opaque
node Annotation #annotation #opaque
node AnnotationEntry #annotation #opaque
node AnnotationTarget #opaque
node TypeArgumentList #opaque
node ValueArgumentList #opaque
node ValueArgument #opaque
node ContractEffectList #opaque
node ContractEffect #opaque
node LambdaArgument #opaque
node ValueArgumentName #opaque
node TypeReference #opaque
node UserType #opaque
node DynamicType #opaque
node FunctionType #opaque
node FunctionTypeReceiver #opaque
node NullableType #opaque
node IntersectionType #opaque
node TypeProjection #opaque
node PropertyAccessor #function #scope =
    ModifierList? Keyword parameters:ValueParameterList? Colon? TypeReference? Keyword? ContractEffectList? body:Block? Eq? expression_body:#expression?
node BackingField #opaque
node InitializerList #opaque
node TypeConstraintList #opaque
node TypeConstraint #opaque
node ConstructorDelegationCall #item #opaque
node ConstructorDelegationReference #item #opaque
node Null #expression #item #literal =
    value:Keyword
node BooleanConstant #expression #item #literal =
    value:Keyword
node FloatConstant #expression #item #literal =
    value:Float
node CharacterConstant #expression #item #literal =
    value:Character
node IntegerConstant #expression #item #literal =
    value:Integer
node StringTemplate #expression #item #literal =
    StringInterpolationPrefix? OpenQuote value:#template-entry* ClosingQuote
node LongStringTemplateEntry #template-entry #opaque
node ShortStringTemplateEntry #template-entry #opaque
node LiteralStringTemplateEntry #template-entry #opaque
node EscapeStringTemplateEntry #template-entry #opaque
node StringInterpolationPrefix #opaque
node Parenthesized #expression #item #opaque
node Return #expression #item #return = Keyword LabelQualifier? value:#item?
node Throw #expression #item #throw = Keyword value:#item
node Continue #expression #item #continue = Keyword label:LabelQualifier?
node Break #expression #item #break = Keyword label:LabelQualifier?
node If #expression #item #conditional =
    Keyword Lpar condition:Condition Rpar then:Then Keyword? orelse=else:Else?
node Condition #opaque
node Then #statements = items:#item*
node Else #statements = items:#item*
node Try #expression #item #try = Keyword body:Block catches:Catch* finally:Finally?
node Catch #catch = Keyword parameter:ValueParameterList? body:Block
node Finally #statements = Keyword items:Block
node For #expression #item #loop = Keyword Lpar Annotation* ValueParameter? DestructuringDeclaration? Keyword iterable:LoopRange? Rpar body:Body?
node While #expression #item #loop = Keyword Lpar condition:Condition Rpar body:Body?
node DoWhile #expression #item #loop = Keyword body:Body? Keyword Lpar condition:Condition Rpar
node LoopRange #opaque
node Body #item #statements = items:#item*
node Block #block #item =
    Lbrace? items:#item* Rbrace?
node LambdaExpression #expression #item #opaque
node FunctionLiteral #function #scope =
    Lbrace parameters:ValueParameterList? Arrow? body:Block? Rbrace
node AnnotatedExpression #expression #item #opaque
node ReferenceExpression #expression #item #reference =
    name:Identifier? Keyword?
node EnumEntrySuperclassReferenceExpression #opaque
node OperationReference #opaque
node Label #opaque
node LabelQualifier #opaque
node ThisExpression #expression #item #opaque
node SuperExpression #expression #item #opaque
node BinaryExpression #expression #item #binary =
    left:#expression operator:OperationReference right:#expression
node BinaryWithType #expression #item #binary =
    left:#expression operator:OperationReference right:TypeReference
node IsExpression #expression #item #binary =
    left:#expression operator:OperationReference right:TypeReference
node PrefixExpression #expression #item #unary =
    operator:OperationReference operand:#expression
node PostfixExpression #expression #item #unary =
    operand:#expression operator:OperationReference
node LabeledExpression #expression #item #opaque
node CallExpression #expression #item #call =
    callee:#expression TypeArgumentList? arguments:ValueArgumentList? LambdaArgument*
node ArrayAccessExpression #expression #item #index =
    object:#expression arguments:Indices
node Indices #opaque
node DotQualifiedExpression #expression #item #member-access =
    object:#expression Dot member:#expression
node CallableReferenceExpression #expression #item #opaque
node ClassLiteralExpression #expression #item #opaque
node SafeAccessExpression #expression #item #member-access =
    object:#expression SafeAccess member:#expression
node ObjectLiteral #expression #item #opaque
node When #expression #item #switch = Keyword Lpar? subject:#item? Rpar? Lbrace cases:WhenEntry* Rbrace
node WhenEntry #case = test:#when-condition* Keyword? WhenEntryGuard? Arrow body:#item?
node WhenEntryGuard #opaque
node WhenConditionInRange #when-condition #opaque
node WhenConditionIsPattern #when-condition #opaque
node WhenConditionExpression #when-condition #opaque
node CollectionLiteralExpression #expression #item #opaque
node PackageDirective #opaque
node Script #scope
node ErrorElement #opaque
