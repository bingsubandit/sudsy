// Python (.py .pyi .pyw), parsed by ruff_python_parser (crates/lang-python/src/adapter.rs).
// Node kinds are ruff's `NodeKind` names, one node per AST node, plus `Parenthesized` (a pair of parentheses and the expression in it); tokens are ruff's `TokenKind` names. Logical and non-logical newlines, indents and dedents are `Newline` / `Whitespace` trivia.
// Format: see crates/core-syntax/src/grammar/mod.rs.

language python 20 "Python"
roles
operators equality "is"
operators arithmetic "//" "@"
comments line "#"
trivia Comment line "#"
trivia Continuation continuation
suppress disable-next-line "sudsy-disable-next-line"
suppress disable-line "sudsy-disable-line"
suppress disable "sudsy-disable"
suppress enable "sudsy-enable"
suppress disable-file "sudsy-disable-file"
suppress ignore "sudsy-ignore"
suppress ignore-start "sudsy-ignore-start"
suppress ignore-end "sudsy-ignore-end"
suppress ignore-start "fmt: off"
suppress ignore-start "fmt:off"
suppress ignore-start "yapf: disable"
suppress ignore-end "fmt: on"
suppress ignore-end "fmt:on"
suppress ignore-end "yapf: enable"
suppress ignore-line "fmt: skip"
suppress ignore-line "fmt:skip"

token Whitespace #trivia #whitespace
token Newline #trivia #newline
// A backslash that ends a line.
token Continuation #trivia #whitespace
token Comment #trivia #comment

token Question "?" #punctuation
token Exclamation "!" #punctuation
token Lpar "(" #punctuation #glue #optional
token Rpar ")" #punctuation #close #optional
token Lsqb "[" #punctuation #glue
token Rsqb "]" #punctuation #close
token Colon ":" #punctuation #glue #part
token Comma "," #punctuation #separator #glue
token Semi ";" #punctuation #separator
token Plus "+" #punctuation #operator #part
token Minus "-" #punctuation #operator #part
token Star "*" #punctuation #operator
token Slash "/" #punctuation #operator
token Vbar "|" #punctuation #operator #part
token Amper "&" #punctuation #operator #part
token Less "<" #punctuation #operator #part
token Greater ">" #punctuation #operator #part
token Equal "=" #punctuation #operator #part
token Dot "." #punctuation #dots
token Percent "%" #punctuation #operator #part
token Lbrace "{" #punctuation
token Rbrace "}" #punctuation
token EqEqual "==" #punctuation #operator #part
token NotEqual "!=" #punctuation #operator #part
token LessEqual "<=" #punctuation #operator #part
token GreaterEqual ">=" #punctuation #operator #part
token Tilde "~" #punctuation #operator #part
token CircumFlex "^" #punctuation #operator #part
token LeftShift "<<" #punctuation #operator #part
token RightShift ">>" #punctuation #operator #part
token DoubleStar "**" #punctuation #operator #part
token DoubleStarEqual "**=" #punctuation #operator #part
token PlusEqual "+=" #punctuation #operator #part
token MinusEqual "-=" #punctuation #operator #part
token StarEqual "*=" #punctuation #operator #part
token SlashEqual "/=" #punctuation #operator #part
token PercentEqual "%=" #punctuation #operator #part
token AmperEqual "&=" #punctuation #operator #part
token VbarEqual "|=" #punctuation #operator #part
token CircumflexEqual "^=" #punctuation #operator #part
token LeftShiftEqual "<<=" #punctuation #operator #part
token RightShiftEqual ">>=" #punctuation #operator #part
token DoubleSlash "//" #punctuation #operator #part
token DoubleSlashEqual "//=" #punctuation #operator #part
token ColonEqual ":=" #punctuation #operator #part
token At "@" #punctuation #operator #part
token AtEqual "@=" #punctuation #operator #part
token Rarrow "->" #punctuation
token Ellipsis "..." #punctuation #constant #dots

// Reserved words; `Case`, `Lazy`, `Match` and `Type` are soft keywords and also appear as names.
token And "and" #keyword #operator #part
token As "as" #keyword
token Assert "assert" #keyword
token Async "async" #keyword
token Await "await" #keyword
token Break "break" #keyword
token Class "class" #keyword
token Continue "continue" #keyword
token Def "def" #keyword
token Del "del" #keyword
token Elif "elif" #keyword
token Else "else" #keyword
token Except "except" #keyword
token False "False" #keyword #constant
token Finally "finally" #keyword #finally
token For "for" #keyword
token From "from" #keyword
token Global "global" #keyword
token If "if" #keyword
token Import "import" #keyword
token In "in" #keyword #operator #part
token Is "is" #keyword #operator #part
token Lambda "lambda" #keyword
token None "None" #keyword #constant
token Nonlocal "nonlocal" #keyword
token Not "not" #keyword #operator #part
token Or "or" #keyword #operator #part
token Pass "pass" #keyword
token Raise "raise" #keyword
token Return "return" #keyword
token True "True" #keyword #constant
token Try "try" #keyword
token While "while" #keyword
token With "with" #keyword
token Yield "yield" #keyword
token Case "case" #keyword
token Lazy "lazy" #keyword
token Match "match" #keyword
token Type "type" #keyword

token Name
token Int #restyle #number
token Float #restyle #number
token Complex #restyle #number
token String #string #restyle
string String quote "\"" "'" triple prefix "rRbBuUfFtT" raw "rR" escape "\\" continuation named "N" octal 3
  replace 63 map "a" 7 "b" 8 "f" 12 "n" 10 "r" 13 "t" 9 "v" 11 "\\" 92 "'" 39 "\"" 34 hex "x" 2 "u" 4 "U" 8
// An f-string's or t-string's start (prefix and opening quote), end (closing quote) and the literal text between its replacement fields.
token FStringStart #string #restyle
token FStringMiddle #string #restyle
token FStringEnd #string #restyle
token TStringStart #string #restyle
token TStringMiddle #string #restyle
token TStringEnd #string #restyle

// Zero-width end-of-file token; it carries the leading trivia of the file's tail.
token EndOfFile
// Text the lexer could not classify.
token Unknown #error

node ModModule #scope #block = items=body:#statement* EndOfFile
node Parenthesized #expression #pattern #part #opaque #transparent
node StmtFunctionDef #statement #declaration #function #scope =
    Decorator* Async? Def name:Identifier TypeParams? parameters:Parameters Rarrow? returns:#expression? Colon body:#statement*
node StmtClassDef #statement #declaration #type-declaration #scope =
    Decorator* Class name:Identifier TypeParams? Arguments? Colon members:#statement*
node StmtReturn #statement #return = Return value:#expression?
node StmtDelete #statement #opaque
node StmtTypeAlias #statement #declaration =
    Type name:ExprName TypeParams? Equal value:#expression
node StmtAssign #statement #assignment =
    left:#expression operator:Equal right:#expression #part*
node StmtAugAssign #statement #assignment =
    left:#expression operator:#operator right:#expression
node StmtAnnAssign #statement #assignment =
    left:#expression Colon annotation:#expression operator:Equal? right:#expression?
node StmtFor #statement #loop =
    Async? For target:#expression In iterable=iter:#expression Colon body:#statement* Else? Colon? orelse:#statement*
node StmtWhile #statement #loop =
    While condition=test:#expression Colon body:#statement* Else? Colon? orelse:#statement*
node StmtIf #statement #conditional #branching =
    If condition=test:#expression Colon then=body:#statement* else=clauses:ElifElseClause*
node StmtWith #statement #opaque #branching
node StmtMatch #statement #switch =
    Match subject:#expression Colon cases:MatchCase*
node StmtRaise #statement #throw = Raise value=exc:#expression? From? cause:#expression?
node StmtTry #statement #try #branching =
    Try Colon body:#statement* catches=handlers:ExceptHandlerExceptHandler* Else? Colon? orelse:#statement* Finally? Colon? finally=finalbody:#statement*
node StmtAssert #statement #opaque
node StmtImport #statement #import =
    Import path=names:Alias*
node StmtImportFrom #statement #import =
    From #dots* module:Identifier? Import path=names:Alias*
node StmtGlobal #statement #opaque
node StmtNonlocal #statement #opaque
node StmtExpr #statement #opaque
node StmtPass #statement #opaque
node StmtBreak #statement #break = Break
node StmtContinue #statement #continue = Continue
node ExprBoolOp #expression #part #binary =
    left:#expression operator:#operator right:#expression #part*
node ExprNamed #expression #part #assignment #named-expr =
    left:#expression operator:ColonEqual right:#expression
node ExprBinOp #expression #part #binary =
    left:#expression operator:#operator right:#expression
node ExprUnaryOp #expression #part #unary =
    operator:#operator operand:#expression
node ExprLambda #expression #part #function #scope =
    Lambda parameters:Parameters? Colon expression_body:#expression
node ExprIf #expression #part #conditional =
    body=then:#expression If condition:#expression Else orelse=else:#expression
node ExprDict #expression #part #opaque #mapping
node ExprSet #expression #part #opaque
node ExprListComp #expression #part #scope
node ExprSetComp #expression #part #scope
node ExprDictComp #expression #part #scope
node ExprGenerator #expression #part #scope
node ExprAwait #expression #part #unary =
    operator:Await operand:#expression
node ExprYield #expression #part #opaque
node ExprYieldFrom #expression #part #opaque
node ExprCompare #expression #part #binary =
    left:#expression operator:#operator* right:#expression #part*
node ExprCall #expression #part #call =
    callee:#expression arguments:Arguments
node ExprFString #expression #part #restyle #literal =
    value:#string-part*
node ExprTString #expression #part #restyle #literal =
    value:TString*
node ExprStringLiteral #expression #part #restyle #literal #string-literal =
    value:StringLiteral*
node ExprBytesLiteral #expression #part #restyle #literal =
    value:BytesLiteral*
node ExprNumberLiteral #expression #part #literal =
    value:#number
node ExprBooleanLiteral #expression #part #literal =
    value:#constant
node ExprNoneLiteral #expression #part #literal =
    value:None
node ExprEllipsisLiteral #expression #part #literal =
    value:Ellipsis
node ExprAttribute #expression #part #member-access =
    object:#expression Dot member:Identifier
node ExprSubscript #expression #part #index =
    object:#expression Lsqb arguments:#expression Rsqb
node ExprStarred #expression #part #opaque #rest
node ExprName #expression #part #reference =
    name:Name
node ExprList #expression #part #opaque #collection
node ExprTuple #expression #part #opaque #collection
node ExprSlice #expression #part #opaque
node ExceptHandlerExceptHandler #catch #branch =
    Except Star? parameter=type:#expression? As? name:Identifier? Colon body:#statement*
node InterpolatedElement #opaque
node InterpolatedStringLiteralElement #opaque
node PatternMatchValue #pattern #opaque
node PatternMatchSingleton #pattern #opaque
node PatternMatchSequence #pattern #opaque
node PatternMatchMapping #pattern #opaque
node PatternMatchClass #pattern #opaque
node PatternMatchStar #pattern #opaque
node PatternMatchAs #pattern #opaque
node PatternMatchOr #pattern #opaque
node TypeParamTypeVar #declaration =
    name:Identifier Colon? bound:#expression? Equal? default:#expression?
node TypeParamTypeVarTuple #declaration =
    Star name:Identifier Equal? default:#expression?
node TypeParamParamSpec #declaration =
    DoubleStar name:Identifier Equal? default:#expression?
node InterpolatedStringFormatSpec #opaque
node PatternArguments #opaque
node PatternKeyword #opaque
node Comprehension #opaque #comprehension =
    Async? For target:#expression In iter:#expression
node Arguments #opaque
node Parameters #parameter-list =
    parameters:#parameter* Slash? #parameter* Star? #parameter*
node Parameter #declaration #parameter =
    Star? DoubleStar? name:Identifier Colon? annotation:#expression?
node ParameterWithDefault #parameter #opaque
node Keyword #opaque
node Alias #opaque = name:Identifier As? asname:Identifier?
node WithItem #opaque #with-item
node MatchCase #case #branch =
    Case test=pattern:#pattern If? guard:#expression? Colon body:#statement*
node Decorator #opaque #decorator
node ElifElseClause #conditional #branch =
    Elif? Else? condition=test:#expression? Colon then=body:#statement*
node TypeParams #opaque
node FString #string-part #opaque
node TString #opaque
node StringLiteral #string-part #opaque
node BytesLiteral #opaque
node Identifier #opaque
