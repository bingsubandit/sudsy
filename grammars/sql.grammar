// SQL (.sql), parsed by sqruff-lib-core with the dialects of `dialect` (crates/lang-sql/src/adapter.rs).
// Nodes are sqlfluff's segment type names (sqruff's `SyntaxKind`, in Pascal case); a segment type with no node here is transparent, except `*_statement`, which is a `Statement` and every `*_reference`, which is an `ObjectReference`.
// Format: see crates/core-syntax/src/grammar/mod.rs.

language sql 27 "SQL"
roles
comments line "--" block "/*" "*/"
suppress disable-next-line "sudsy-disable-next-line"
suppress disable-line "sudsy-disable-line"
suppress disable "sudsy-disable"
suppress enable "sudsy-enable"
suppress disable-file "sudsy-disable-file"
suppress ignore "sudsy-ignore"

token Whitespace #trivia #whitespace
token Newline #trivia #newline
token LineComment #trivia #comment
token BlockComment #trivia #comment #indentable

token LParen "(" #punctuation #glue
token RParen ")" #punctuation #close
token LSquare "[" #punctuation
token RSquare "]" #punctuation #close
token Comma "," #punctuation #separator #glue
token Semicolon ";" #punctuation #separator
token Dot "." #punctuation #name-part
token CastOp "::" #punctuation
token Colon ":" #punctuation
// The `:` of an array slice, the `:` in front of a psql variable.
token Slice #punctuation
token Prefix #punctuation
// A sign in front of a number or an expression.
token Sign #punctuation
// Every other symbol: `=`, `<>`, `||`, `*`, `@`, ...
token Operator #punctuation #name-part
// `+`, `-`, `*`, `/`, `||` between operands.
token BinaryOperator #punctuation
token Keyword #restyle
// `AND`, `OR`.
token BinaryKeyword #restyle
token Identifier #restyle #name-part
token FunctionIdentifier #restyle
token TypeIdentifier #restyle
// `TRUE`, `FALSE`, `NULL`.
token WordLiteral #restyle
// A word the parser left untyped.
token Word #name-part
token QuotedIdentifier #name-part
token String #literal #string
token Number #literal

// Where the parser opens (`Indent`, `ImplicitIndent`) or closes (`Dedent`) an indented block: zero-width, they carry the
// indentation structure of the file.
token Indent #optional
token ImplicitIndent #optional
token Dedent #optional

// Zero-width end-of-file token; it carries the leading trivia of the file's tail.
token Eof
// Text the lexer or the parser could not classify.
token Unknown #error

node File #scope
node Statement #opaque
node SelectStatement #scope
node SetExpression #opaque
node WithCompoundStatement #scope
node CommonTableExpression #opaque
node SelectClause #opaque
node SelectClauseElement #opaque
node FromClause #opaque
node FromExpression #opaque
node FromExpressionElement #opaque
node TableExpression #opaque
node JoinClause #opaque
node JoinOnCondition #opaque
node WhereClause #opaque
node GroupbyClause #opaque
node HavingClause #opaque
node OrderbyClause #opaque
node LimitClause #opaque
node WindowSpecification #opaque
node OverClause #opaque
node Expression #opaque
node Function #call =
    callee:FunctionName arguments:FunctionContents OverClause? Keyword* Bracketed? OverClause?
node FunctionName #opaque
node Bracketed #opaque
node ObjectReference #reference =
    ObjectReference? name:#name-part* FunctionContents?
node FunctionContents #opaque
node SetOperator #opaque
node SelectClauseModifier #opaque
node ComparisonOperator #opaque
node ArrayAccessor #opaque
node AliasColumnList #opaque
node BracketedArguments #opaque
node SemiStructuredExpression #opaque
node AliasExpression #declaration =
    Keyword? name:#name-part* Bracketed? AliasColumnList?
node CaseExpression #opaque
node WhenClause #opaque
node ElseClause #opaque
node InsertStatement #opaque
node UpdateStatement #opaque
node DeleteStatement #opaque
node CreateTableStatement #opaque
node ColumnDefinition #opaque
node Values #opaque
