<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the StyleCop analyzers over a folder of C# files as a driver, not through the compiler: the compiler skips
       analyzers when the compilation has errors, and a corpus of unrelated files has many (docs/ai/development/parity.md).
       StyleCopVersion comes from the command line (docs/ai/parity/stylecop.yaml). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StyleCopVersion Condition="'$(StyleCopVersion)' == ''">1.2.0-beta.556</StyleCopVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageReference Include="StyleCop.Analyzers.Unstable" Version="$(StyleCopVersion)" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="analyzers" />
    <None Include="$(PkgStyleCop_Analyzers_Unstable)/analyzers/dotnet/cs/StyleCop.Analyzers.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
