      "input": "stdin",
      "fixtures": [{"suffixes": [".json", ".jsonc", ".yaml", ".yml"]}]
    },
    "taplo": {"speed": {"language": "TOML", "label": "taplo", "corpus": {"group": "fixtures", "text": "the toml-test valid files and the TOML fixtures of the repository"}, "format": ["{exe}", "fmt", "--check", "--no-auto-config", "{files}"]}, 
      "catalog": "taplo",
      "install": {
        "release": "https://github.com/tamasfe/taplo/releases/download/{version}/{asset}",
