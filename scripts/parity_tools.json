      "input": "arg",
      "tool_may_reject": true,
      "parallel": true,
      "quiet": true,
      "fixtures": [
        {"dir": "tests/conformance/corpus/html", "suffixes": [".html", ".htm"], "only": "prettier/tests/format/html/", "ratchet": "prettier-html", "recursive": true},
        {"dir": "tests/conformance/corpus/html", "suffixes": [".html", ".htm"], "only": "prettier/tests/format/vue/", "ratchet": "prettier-vue-html", "recursive": true},
        {"dir": "tests/conformance/corpus/html", "suffixes": [".vue"], "only": "prettier/tests/format/vue/", "ratchet": "prettier-vue", "recursive": true},
        {"dir": "tests/conformance/corpus/html", "suffixes": [".vue"], "skip": "prettier/", "prefix": "corpus/", "ratchet": "real-world-vue", "recursive": true},
        {"dir": "tests/conformance/corpus/html", "suffixes": ["input.svelte"], "only": "prettier-plugin-svelte/", "ratchet": "prettier-svelte", "recursive": true},
        {"dir": "tests/conformance/corpus/html", "suffixes": [".svelte"], "skip": "prettier-plugin-svelte/", "prefix": "corpus/", "ratchet": "real-world-svelte", "recursive": true},
        {"dir": "tests/conformance/corpus/html", "suffixes": [".html", ".htm"], "skip": "prettier/", "prefix": "corpus/", "ratchet": "real-world", "recursive": true}
      ]
    },
    "prettier-angular": {"speed": {"language": "Angular", "label": "Prettier", "corpus": {"group": "angular"}, "not_measured": {"format": "Prettier picks its Angular parser from the .component.html name, which the corpus files do not carry"}}, 
      "catalog": "prettier",
      "install": {"npm": "prettier"},
      "fetch": ["tests/conformance/fetch-angular-corpus.sh"],
