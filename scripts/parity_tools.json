        {"dir": "tests/conformance/corpus/angular", "suffixes": [".html"], "only": "angular/", "prefix": "corpus/", "ratchet": "angular", "recursive": true},
        {"dir": "tests/conformance/corpus/angular", "suffixes": [".html"], "only": "angular-realworld-example-app/", "prefix": "corpus/", "ratchet": "realworld-app", "recursive": true}
