        {"dir": "tests/conformance/corpus/toml-test/tests", "list": "files-toml-1.0.0", "starts": "valid/", "suffixes": [".toml"]}
      ]
    },
    "ruff": {"speed": {"language": "Python", "label": "ruff", "corpus": {"group": "real-world", "text": "the Python corpus (Django, Requests, Flask, Click, HTTPX, pytest, Black)"}, "format": ["{python}", "-m", "ruff", "format", "--check", "--isolated", "--no-cache", "."], "lint": ["{python}", "-m", "ruff", "check", "--isolated", "--no-cache", "."]}, 
      "catalog": "ruff",
