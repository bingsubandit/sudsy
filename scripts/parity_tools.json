      "parallel": true,
      "quiet": true,
      "fixtures": [
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "black/tests/data/", "ratchet": "black-tests", "recursive": true},
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "ruff/crates/ruff_python_formatter/", "skip_with": ".options.json", "ratchet": "ruff-fixtures", "recursive": true},
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "django/django/", "ratchet": "real-world", "recursive": true},
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "requests/src/", "ratchet": "real-world", "recursive": true},
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "flask/src/", "ratchet": "real-world", "recursive": true},
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "click/src/", "ratchet": "real-world", "recursive": true},
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "httpx/httpx/", "ratchet": "real-world", "recursive": true},
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "pytest/src/", "ratchet": "real-world", "recursive": true},
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "black/src/", "ratchet": "real-world", "recursive": true}
      ]
    },
    "sqlfluff": {"speed": {"language": "SQL", "label": "sqlfluff", "corpus": {"group": "sqlfluff-ansi", "text": "the ANSI dialect fixtures of sqlfluff"}, "env": {"PYTHONPATH": "{prefix}"}, "format": ["{python}", "-m", "sqlfluff", "lint", "--rules", "layout,capitalisation", "--dialect", "ansi", "--nocolor", "."], "lint": ["{python}", "-m", "sqlfluff", "lint", "--dialect", "ansi", "--nocolor", "."]}, 
