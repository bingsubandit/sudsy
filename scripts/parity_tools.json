{
  "format": {
    "prettier": {
      "catalog": "prettier",
      "install": {"npm": "prettier"},
      "fetch": ["tests/conformance/fetch-markdown-corpus.sh", "tests/conformance/fetch-graphql-corpus.sh"],
      "command": ["node", "{prefix}/node_modules/prettier/bin/prettier.cjs", "--no-config", "--no-editorconfig", "--embedded-language-formatting=off", "{file}"],
      "input": "arg",
      "tool_may_reject": true,
      "fixtures": [
        {"suffixes": [".json", ".jsonc", ".yaml", ".yml", ".md", ".graphql", ".gql"]},
        {"dir": "docs", "suffixes": [".md"], "prefix": "docs/", "recursive": true},
        {"dir": "tests/conformance/corpus/runtime-docs/docs", "suffixes": [".md"], "prefix": "runtime-docs/", "recursive": true},
        {"dir": "tests/conformance/corpus/graphql", "suffixes": [".graphql", ".gql"], "prefix": "graphql/", "recursive": true}
      ]
    },
    "prettier-js": {
      "catalog": "prettier",
      "install": {"npm": "prettier"},
      "fetch": ["tests/conformance/fetch-js-corpus.sh"],
      "command": ["node", "{prefix}/node_modules/prettier/bin/prettier.cjs", "--no-config", "--no-editorconfig", "--embedded-language-formatting=off", "{file}"],
      "input": "arg",
      "tool_may_reject": true,
      "parallel": true,
      "quiet": true,
      "fixtures": [
        {"dir": "tests/conformance/corpus/js", "suffixes": [".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".mts", ".cts"], "only": "prettier/", "ratchet": "prettier-tests", "recursive": true},
        {"dir": "tests/conformance/corpus/js", "suffixes": [".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".mts", ".cts"], "skip": "prettier/", "prefix": "corpus/", "ratchet": "real-world", "recursive": true}
      ]
    },
    "prettier-css": {
      "catalog": "prettier",
      "install": {"npm": "prettier"},
      "fetch": ["tests/conformance/fetch-css-corpus.sh"],
      "command": ["node", "{prefix}/node_modules/prettier/bin/prettier.cjs", "--no-config", "--no-editorconfig", "{file}"],
      "input": "arg",
      "tool_may_reject": true,
      "parallel": true,
      "quiet": true,
      "fixtures": [
        {"dir": "tests/conformance/corpus/css", "suffixes": [".css"], "only": "prettier/tests/format/css/", "ratchet": "prettier-css", "recursive": true},
        {"dir": "tests/conformance/corpus/css", "suffixes": [".scss"], "only": "prettier/tests/format/scss/", "ratchet": "prettier-scss", "recursive": true},
        {"dir": "tests/conformance/corpus/css", "suffixes": [".less"], "only": "prettier/tests/format/less/", "ratchet": "prettier-less", "recursive": true},
        {"dir": "tests/conformance/corpus/css", "suffixes": [".css", ".scss", ".less"], "skip": "prettier/", "prefix": "corpus/", "ratchet": "real-world", "recursive": true}
      ]
    },
    "prettier-html": {
      "catalog": "prettier",
      "install": {"npm": "prettier", "with": ["prettier-plugin-svelte@3.5.2"]},
      "fetch": ["tests/conformance/fetch-html-corpus.sh"],
      "command": ["node", "{prefix}/node_modules/prettier/bin/prettier.cjs", "--no-config", "--no-editorconfig", "--plugin", "{prefix}/node_modules/prettier-plugin-svelte/plugin.js", "{file}"],
      "input": "arg",
      "tool_may_reject": true,
      "parallel": true,
      "quiet": true,
      "fixtures": [
        {"dir": "tests/conformance/corpus/html", "suffixes": [".html", ".htm"], "only": "prettier/tests/format/html/", "ratchet": "prettier-html", "recursive": true},
        {"dir": "tests/conformance/corpus/html", "suffixes": [".html", ".htm"], "only": "prettier/tests/format/vue/", "ratchet": "prettier-vue-html", "recursive": true},
        {"dir": "tests/conformance/corpus/html", "suffixes": [".vue"], "only": "prettier/tests/format/vue/", "ratchet": "prettier-vue", "recursive": true},
        {"dir": "tests/conformance/corpus/html", "suffixes": [".vue"], "skip": "prettier/", "prefix": "corpus/", "ratchet": "real-world-vue", "recursive": true},
        {"dir": "tests/conformance/corpus/html", "suffixes": ["input.svelte"], "only": "prettier-plugin-svelte/", "ratchet": "prettier-svelte", "recursive": true},
        {"dir": "tests/conformance/corpus/html", "suffixes": [".svelte"], "skip": "prettier-plugin-svelte/", "prefix": "corpus/", "ratchet": "real-world-svelte", "recursive": true},
        {"dir": "tests/conformance/corpus/html", "suffixes": [".html", ".htm"], "skip": "prettier/", "prefix": "corpus/", "ratchet": "real-world", "recursive": true}
      ]
    },
    "prettier-angular": {
      "catalog": "prettier",
      "install": {"npm": "prettier"},
      "fetch": ["tests/conformance/fetch-angular-corpus.sh"],
      "command": ["node", "{prefix}/node_modules/prettier/bin/prettier.cjs", "--no-config", "--no-editorconfig", "{file}"],
      "input": "arg",
      "copy_suffix": ".component.html",
      "tool_may_reject": true,
      "parallel": true,
      "quiet": true,
      "fixtures": [
        {"dir": "tests/conformance/corpus/angular", "suffixes": [".html"], "only": "prettier/", "ratchet": "prettier-angular", "recursive": true},
        {"dir": "tests/conformance/corpus/angular", "suffixes": [".html"], "only": "components/", "prefix": "corpus/", "ratchet": "components", "recursive": true},
        {"dir": "tests/conformance/corpus/angular", "suffixes": [".html"], "only": "angular/", "prefix": "corpus/", "ratchet": "angular", "recursive": true},
        {"dir": "tests/conformance/corpus/angular", "suffixes": [".html"], "only": "angular-realworld-example-app/", "prefix": "corpus/", "ratchet": "realworld-app", "recursive": true}
      ]
    },
    "biome": {
      "catalog": "biome",
      "install": {"npm": "@biomejs/biome"},
      "command": ["node", "{prefix}/node_modules/@biomejs/biome/bin/biome", "format", "--stdin-file-path={file}"],
      "input": "stdin",
      "fixtures": [{"suffixes": [".json", ".jsonc", ".yaml", ".yml"]}]
    },
    "taplo": {
      "catalog": "taplo",
      "install": {
        "release": "https://github.com/tamasfe/taplo/releases/download/{version}/{asset}",
        "assets": {
          "windows": "taplo-windows-x86_64.zip",
          "linux-x86_64": "taplo-linux-x86_64.gz",
          "linux-aarch64": "taplo-linux-aarch64.gz",
          "darwin-arm64": "taplo-darwin-aarch64.gz",
          "darwin-x86_64": "taplo-darwin-x86_64.gz"
        },
        "exe": "taplo"
      },
      "fetch": ["tests/conformance/fetch-toml-corpus.sh"],
      "command": ["{exe}", "fmt", "--no-auto-config", "-"],
      "input": "stdin",
      "tool_may_reject": true,
      "fixtures": [
        {"suffixes": [".toml"]},
        {"dir": "tests/fixtures/toml", "suffixes": [".toml"], "prefix": "fixtures/"},
        {"dir": "tests/conformance/corpus/toml-test/tests", "list": "files-toml-1.0.0", "starts": "valid/", "suffixes": [".toml"]}
      ]
    },
    "ruff": {
      "catalog": "ruff",
      "install": {"pip": "ruff"},
      "fetch": ["tests/conformance/fetch-python-corpus.sh"],
      "command": ["{python}", "-m", "ruff", "format", "--isolated", "--no-cache", "--quiet", "{file}"],
      "env": {"PYTHONPATH": "{prefix}"},
      "input": "in-place",
      "tool_may_reject": true,
      "parallel": true,
      "quiet": true,
      "fixtures": [
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "black/tests/data/", "ratchet": "black-tests", "recursive": true},
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "ruff/crates/ruff_python_formatter/", "skip_with": ".options.json", "ratchet": "ruff-fixtures", "recursive": true},
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "django/django/", "ratchet": "real-world", "recursive": true},
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "requests/src/", "ratchet": "real-world", "recursive": true},
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "flask/src/", "ratchet": "real-world", "recursive": true},
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "click/src/", "ratchet": "real-world", "recursive": true},
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "httpx/httpx/", "ratchet": "real-world", "recursive": true},
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "pytest/src/", "ratchet": "real-world", "recursive": true},
        {"dir": "tests/conformance/corpus/python", "suffixes": [".py", ".pyi"], "only": "black/src/", "ratchet": "real-world", "recursive": true}
      ]
    },
    "sqlfluff": {
      "catalog": "sqlfluff",
      "install": {"pip": "sqlfluff"},
      "fetch": ["tests/conformance/fetch-sql-corpus.sh"],
      "command": ["{python}", "-m", "sqlfluff", "fix", "--rules", "layout,capitalisation", "--dialect", "{group}", "--nocolor", "{file}"],
      "env": {"PYTHONPATH": "{prefix}"},
      "group": "^(.*?)__",
      "input": "in-place",
      "tool_may_reject": true,
      "parallel": true,
      "quiet": true,
      "fixtures": [
        {"dir": "tests/conformance/corpus/sql/sqlfluff/test/fixtures/dialects/ansi", "suffixes": [".sql"], "prefix": "ansi/", "ratchet": "sqlfluff-ansi"},
        {"dir": "tests/conformance/corpus/sql/sqlfluff/test/fixtures/dialects/postgres", "suffixes": [".sql"], "prefix": "postgres/", "ratchet": "sqlfluff-postgres"},
        {"dir": "tests/conformance/corpus/sql/sqlfluff/test/fixtures/dialects/mysql", "suffixes": [".sql"], "prefix": "mysql/", "ratchet": "sqlfluff-mysql"},
        {"dir": "tests/conformance/corpus/sql/sqlfluff/test/fixtures/dialects/tsql", "suffixes": [".sql"], "prefix": "tsql/", "ratchet": "sqlfluff-tsql"},
        {"dir": "tests/conformance/corpus/sql/postgres/src/test/regress/sql", "suffixes": [".sql"], "prefix": "postgres/regress-", "ratchet": "postgres-regress"}
      ],
      "coverage": {"corpus": [{"dir": "tests/conformance/corpus/sql", "glob": ["*.sql"]}], "group": "(?:dialects/|^sql/)(ansi|postgres|mysql|tsql)/", "command": ["{python}", "-m", "sqlfluff", "lint", "--dialect", "{group}", "--format", "json", "--nocolor", "--processes", "8", "{files}"], "timeout": 7200, "env": {"PYTHONPATH": "{prefix}"}, "parse": {"format": "json", "levels": ["", "violations"], "file": "0.filepath", "rule": "1.code", "message": "1.description"}}
    },
    "shfmt": {
      "catalog": "shfmt",
      "install": {
        "release": "https://github.com/mvdan/sh/releases/download/v{version}/{asset}",
        "assets": {
          "windows": "shfmt_v{version}_windows_amd64.exe",
          "linux-x86_64": "shfmt_v{version}_linux_amd64",
          "linux-aarch64": "shfmt_v{version}_linux_arm64",
          "darwin-arm64": "shfmt_v{version}_darwin_arm64",
          "darwin-x86_64": "shfmt_v{version}_darwin_amd64"
        },
        "exe": "shfmt"
      },
      "fetch": ["tests/conformance/fetch-shell-corpus.sh"],
      "command": ["{exe}", "{file}"],
      "input": "arg",
      "tool_may_reject": true,
      "fixtures": [
        {"suffixes": [".sh"]},
        {"dir": "tests/conformance/corpus/shell", "suffixes": [".sh", ".bash"], "prefix": "corpus/", "recursive": true}
      ]
    },
    "google-java-format": {
      "catalog": "google-java-format",
      "install": {
        "release": "https://github.com/google/google-java-format/releases/download/v{version}/{asset}",
        "assets": {
          "windows": "google-java-format_windows-x86-64.exe",
          "linux-x86_64": "google-java-format_linux-x86-64",
          "linux-aarch64": "google-java-format_linux-arm64",
          "darwin-arm64": "google-java-format_darwin-arm64"
        },
        "exe": "google-java-format"
      },
      "fetch": ["tests/conformance/fetch-java-corpus.sh"],
      "command": ["{exe}", "--replace", "--skip-javadoc-formatting", "--skip-removing-unused-imports", "--skip-reflowing-long-strings", "{file}"],
      "input": "in-place",
      "tool_may_reject": true,
      "parallel": true,
      "quiet": true,
      "fixtures": [
        {"suffixes": [".java"]},
        {"dir": "tests/conformance/corpus/java", "suffixes": [".java"], "prefix": "corpus/", "ratchet": "real-world", "recursive": true}
      ]
    },
    "ktlint": {
      "catalog": "ktlint",
      "install": {
        "jar": "https://repo1.maven.org/maven2/com/pinterest/ktlint/ktlint-cli/{version}/ktlint-cli-{version}-all.jar",
        "sha256": "369ad2b789f95a011f807e1fcb690ccef80bd7cd014fd139e73ae82dcc0baeab",
        "exe": "ktlint"
      },
      "fetch": ["tests/conformance/fetch-kotlin-corpus.sh"],
      "command": ["{exe}", "--format"],
      "input": "batch",
      "reject": "^.*/([^/:]+):\\d+:\\d+: Not a valid Kotlin file",
      "tool_may_reject": true,
      "parallel": true,
      "quiet": true,
      "fixtures": [
        {"suffixes": [".kt", ".kts"]},
        {"dir": "tests/conformance/corpus/kotlin", "suffixes": [".kt", ".kts"], "skip": "kotlin/compiler/", "prefix": "corpus/", "ratchet": "real-world", "recursive": true}
      ]
    },
    "php-cs-fixer": {
      "catalog": "php-cs-fixer",
      "install": {
        "release": "https://dl.static-php.dev/static-php-cli/common/{asset}",
        "assets": {
          "linux-x86_64": "php-8.4.23-cli-linux-x86_64.tar.gz",
          "linux-aarch64": "php-8.4.23-cli-linux-aarch64.tar.gz",
          "darwin-arm64": "php-8.4.23-cli-macos-aarch64.tar.gz",
          "darwin-x86_64": "php-8.4.23-cli-macos-x86_64.tar.gz",
          "windows": "php-8.4.23-cli-win.zip"
        },
        "files": {"php-cs-fixer.phar": "https://github.com/PHP-CS-Fixer/PHP-CS-Fixer/releases/download/v{version}/php-cs-fixer.phar"},
        "exe": "php"
      },
      "fetch": ["tests/conformance/fetch-php-corpus.sh"],
      "command": ["{exe}", "{prefix}/php-cs-fixer.phar", "fix", "--config={root}/tests/parity/php-cs-fixer/per-cs.config", "--sequential", "--no-interaction", "--show-progress=none", "-v"],
      "chunk": 200,
      "input": "batch",
      "reject": "^\\s+\\d+\\) (?:.*/)?([^/\\s]+\\.php)\\s*$",
      "tool_may_reject": true,
      "parallel": true,
      "quiet": true,
      "fixtures": [
        {"dir": "tests/conformance/corpus/php", "suffixes": [".php"], "prefix": "corpus/", "ratchet": "real-world", "recursive": true}
      ]
    },
    "clang-format": {
      "catalog": "clang-format",
      "install": {"pip": "clang-format", "dir": "clang_format"},
      "fetch": ["tests/conformance/fetch-cpp-corpus.sh"],
      "command": ["{prefix}/clang_format/data/bin/clang-format", "--style=file:{folder}/{style}.clang-format", "{file}"],
      "input": "arg",
      "tool_may_reject": true,
      "parallel": true,
      "quiet": true,
      "fixtures": [
        {"dir": "tests/conformance/corpus/cpp/llvm-project", "suffixes": [".cpp", ".h"], "style": "llvm", "ratchet": "llvm", "prefix": "llvm/", "recursive": true, "copy_as": ".cpp"},
        {"dir": "tests/conformance/corpus/cpp/fmt", "suffixes": [".cc", ".h", ".cpp"], "style": "fmt", "ratchet": "fmt", "prefix": "fmt/", "recursive": true, "copy_as": ".cpp"},
        {"dir": "tests/conformance/corpus/cpp/range-v3", "suffixes": [".hpp", ".cpp"], "style": "range-v3", "ratchet": "range-v3", "prefix": "range-v3/", "recursive": true, "copy_as": ".cpp"},
        {"dir": "tests/conformance/corpus/cpp/folly", "suffixes": [".cpp", ".h"], "style": "llvm", "ratchet": "folly", "prefix": "folly/", "recursive": true, "copy_as": ".cpp"},
        {"dir": "tests/conformance/corpus/cpp/linux", "suffixes": [".c", ".h"], "style": "linux", "ratchet": "linux", "prefix": "linux/", "recursive": true, "copy_as": ".c"},
        {"dir": "tests/conformance/corpus/cpp/sqlite", "suffixes": [".c", ".h"], "style": "llvm", "ratchet": "sqlite", "prefix": "sqlite/", "recursive": true, "copy_as": ".c"},
        {"dir": "bench/inputs/cpp", "suffixes": [".cpp", ".hpp"], "style": "google", "ratchet": "google", "prefix": "google/cpp/"},
        {"dir": "bench/inputs/c", "suffixes": [".c"], "style": "google", "ratchet": "google", "prefix": "google/c/"},
        {"dir": "bench/inputs/cpp", "suffixes": [".cpp", ".hpp"], "style": "chromium", "ratchet": "chromium", "prefix": "chromium/cpp/"},
        {"dir": "bench/inputs/c", "suffixes": [".c"], "style": "chromium", "ratchet": "chromium", "prefix": "chromium/c/"},
        {"dir": "bench/inputs/cpp", "suffixes": [".cpp", ".hpp"], "style": "mozilla", "ratchet": "mozilla", "prefix": "mozilla/cpp/"},
        {"dir": "bench/inputs/c", "suffixes": [".c"], "style": "mozilla", "ratchet": "mozilla", "prefix": "mozilla/c/"},
        {"dir": "bench/inputs/cpp", "suffixes": [".cpp", ".hpp"], "style": "webkit", "ratchet": "webkit", "prefix": "webkit/cpp/"},
        {"dir": "bench/inputs/c", "suffixes": [".c"], "style": "webkit", "ratchet": "webkit", "prefix": "webkit/c/"},
        {"dir": "bench/inputs/cpp", "suffixes": [".cpp", ".hpp"], "style": "gnu", "ratchet": "gnu", "prefix": "gnu/cpp/"},
        {"dir": "bench/inputs/c", "suffixes": [".c"], "style": "gnu", "ratchet": "gnu", "prefix": "gnu/c/"},
        {"dir": "bench/inputs/cpp", "suffixes": [".cpp", ".hpp"], "style": "microsoft", "ratchet": "microsoft", "prefix": "microsoft/cpp/"},
        {"dir": "bench/inputs/c", "suffixes": [".c"], "style": "microsoft", "ratchet": "microsoft", "prefix": "microsoft/c/"}
      ]
    },
    "invoke-formatter": {
      "catalog": "psscriptanalyzer",
      "install": {"psmodule": "PSScriptAnalyzer"},
      "fetch": ["tests/conformance/fetch-powershell-corpus.sh"],
      "command": ["pwsh", "-NoProfile", "-File", "{root}/scripts/parity_invoke_formatter.ps1", "{prefix}", "{file}"],
      "input": "arg",
      "tool_may_reject": true,
      "ignore_trailing_blanks": true,
      "fixtures": [
        {"suffixes": [".ps1"]},
        {"dir": "tests/conformance/corpus/powershell", "suffixes": [".ps1", ".psm1"], "prefix": "corpus/", "recursive": true}
      ]
    },
    "buf": {
      "catalog": "buf",
      "install": {
        "release": "https://github.com/bufbuild/buf/releases/download/v{version}/{asset}",
        "assets": {
          "windows": "buf-Windows-x86_64.exe",
          "linux-x86_64": "buf-Linux-x86_64",
          "linux-aarch64": "buf-Linux-aarch64",
          "darwin-arm64": "buf-Darwin-arm64",
          "darwin-x86_64": "buf-Darwin-x86_64"
        },
        "exe": "buf"
      },
      "fetch": ["tests/conformance/fetch-proto-corpus.sh"],
      "command": ["{exe}", "format", "{file}"],
      "input": "arg",
      "tool_may_reject": true,
      "fixtures": [
        {"suffixes": [".proto"]},
        {"dir": "tests/conformance/corpus/proto", "suffixes": [".proto"], "prefix": "corpus/", "recursive": true}
      ]
    },
    "terraform": {
      "catalog": "terraform",
      "install": {
        "release": "https://releases.hashicorp.com/terraform/{version}/{asset}",
        "assets": {
          "windows": "terraform_{version}_windows_amd64.zip",
          "linux-x86_64": "terraform_{version}_linux_amd64.zip",
          "linux-aarch64": "terraform_{version}_linux_arm64.zip",
          "darwin-arm64": "terraform_{version}_darwin_arm64.zip",
          "darwin-x86_64": "terraform_{version}_darwin_amd64.zip"
        },
        "exe": "terraform"
      },
      "fetch": ["tests/conformance/fetch-hcl-corpus.sh"],
      "command": ["{exe}", "fmt", "-no-color", "-"],
      "input": "stdin",
      "sudsy_command": "fix",
      "tool_may_reject": true,
      "fixtures": [
        {"suffixes": [".tf"]},
        {"dir": "tests/conformance/corpus/hcl", "suffixes": [".tf", ".pkr.hcl"], "prefix": "corpus/", "recursive": true}
      ]
    },
    "csharpier": {
      "catalog": "csharpier",
      "install": {"dotnet-tool": "csharpier", "exe": "csharpier"},
      "needs": ["worker"],
      "command": ["{exe}", "format", "{file}"],
      "input": "in-place",
      "tool_may_reject": true,
      "fixtures": [{"suffixes": [".cs"]}]
    },
    "csharpier-xml": {
      "catalog": "csharpier",
      "install": {"dotnet-tool": "csharpier", "exe": "csharpier"},
      "fetch": ["tests/conformance/fetch-xml-projects.sh"],
      "command": ["{exe}", "format", "{file}"],
      "input": "in-place",
      "tool_may_reject": true,
      "fixtures": [
        {"suffixes": [".csproj", ".props", ".targets", ".config", ".resx", ".xml", ".slnx", ".xaml"]},
        {"dir": "tests/fixtures/xml", "suffixes": [".csproj", ".props", ".targets", ".config", ".resx", ".xml", ".slnx", ".xaml"], "prefix": "fixtures/"},
        {"dir": "tests/conformance/corpus/xml-projects", "suffixes": [".csproj", ".props", ".targets", ".config", ".resx", ".xml", ".slnx", ".xaml"], "prefix": "corpus/", "recursive": true}
      ]
    },
    "dotnet-format": {
      "version_command": ["dotnet", "--version"],
      "needs": ["worker"],
      "kind": "editorconfig-cases"
    }
  },
  "lint": {
    "ruff": {"preset": "python/ruff", "catalog": "ruff", "install": "ruff", "fetch": ["tests/conformance/fetch-python-corpus.sh"], "command": ["{python}", "-m", "ruff", "check", "--isolated", "--no-cache", "--output-format", "json", "--exit-zero", "--ignore-noqa", "--target-version", "py314"], "env": {"PYTHONPATH": "{prefix}"}},
