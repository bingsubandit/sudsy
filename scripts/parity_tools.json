    "prettier-html": {"speed": {"language": "HTML", "label": "Prettier", "corpus": {"group": "real-world", "text": "the HTML corpus (mdn learning-area and others)"}, "format": ["node", "{prefix}/node_modules/prettier/bin/prettier.cjs", "--check", "--no-cache", "--log-level", "warn", "."]}, 
