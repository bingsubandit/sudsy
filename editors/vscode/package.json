{
  "name": "sudsy",
  "displayName": "Sudsy",
  "description": "Formatter and linter for C#, JavaScript/TypeScript, Python, Java, Kotlin, C/C++ and more.",
  "version": "0.0.3",
  "publisher": "sudsy",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bingsubandit/sudsy"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "JSON",
    "CSS",
    "HTML",
    "C",
    "C++",
    "Batchfile",
    "CMake",
    "Dockerfile",
    "Go",
    "GraphQL",
    "HCL",
    "Java",
    "JavaScript",
    "TypeScript",
    "Kotlin",
    "Makefile",
    "Markdown",
    "PHP",
    "PowerShell",
    "Protobuf",
    "Python",
    "Ruby",
    "Shell",
    "SQL",
    "TOML",
    "XML",
    "YAML",
    "C#",
    "formatter",
    "linter"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less",
    "onLanguage:html",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:bat",
    "onLanguage:cmake",
    "onLanguage:dockerfile",
    "onLanguage:editorconfig",
    "onLanguage:ignore",
    "onLanguage:go",
    "onLanguage:graphql",
    "onLanguage:terraform",
    "onLanguage:hcl",
    "onLanguage:ini",
    "onLanguage:java",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:kotlin",
    "onLanguage:makefile",
    "onLanguage:markdown",
    "onLanguage:php",
    "onLanguage:powershell",
    "onLanguage:proto3",
    "onLanguage:proto",
    "onLanguage:python",
    "onLanguage:ruby",
    "onLanguage:shellscript",
    "onLanguage:sql",
    "onLanguage:toml",
    "onLanguage:xml",
    "onLanguage:yaml",
    "onLanguage:csharp",
    "workspaceContains:**/sudsy.{yaml,yml}"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "main": "./dist/extension.js",
  "contributes": {
    "yamlValidation": [
      {
        "fileMatch": [
          "sudsy.yaml",
          "sudsy.yml"
        ],
        "url": "./schemas/sudsy.schema.json"
      }
    ],
    "commands": [
      {
        "command": "sudsy.restartServer",
        "title": "Sudsy: Restart Server"
      },
      {
        "command": "sudsy.showOutput",
        "title": "Sudsy: Show Output"
      }
    ],
    "configuration": {
      "title": "Sudsy",
      "properties": {
        "sudsy.serverPath": {
          "type": "string",
          "scope": "machine",
          "description": "Path of the `sudsy` executable (`${workspaceFolder}` is the first workspace folder). Empty: see `sudsy.importStrategy`. Ignored with `useBundled`."
        },
        "sudsy.csharpWorkerPath": {
          "type": "string",
          "scope": "machine",
          "description": "Path of `Sudsy.Worker.dll`, the C# worker. Empty: the one next to the executable."
        },
        "sudsy.importStrategy": {
          "type": "string",
          "enum": [
            "fromEnvironment",
            "useBundled"
          ],
          "enumDescriptions": [
            "Use `sudsy.serverPath` if set, else the first `sudsy` on PATH, else the bundled executable.",
            "Always use the executable bundled with the extension."
          ],
          "default": "fromEnvironment",
          "description": "Which `sudsy` executable the extension runs."
        },
        "sudsy.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the messages between VS Code and the server in the Sudsy output channel."
        }
      }
    }
  },
  "scripts": {
    "prepare-schema": "node scripts/copy-schema.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run prepare-schema && node scripts/build.mjs",
    "test": "tsc -p tsconfig.test.json && node --test \"out/test/*.test.js\"",
    "stage-server": "node scripts/stage-server.mjs",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
