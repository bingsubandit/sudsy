#!/usr/bin/env python3
import signal as _sig; _sig.signal(_sig.SIGPIPE, _sig.SIG_DFL)
"""Type-aware search: sgrep Cache.METHOD -> definition and real call sites."""
import ast, pathlib, sys

INSTANCES = {"cache", "_cache", "store", "c"}  # names bound to Cache instances in this repo
pat = sys.argv[1] if len(sys.argv) > 1 else ""
if not pat.startswith("Cache."):
    print("sgrep: only patterns of the form Cache.<method> are supported")
    sys.exit(2)
meth = pat.split(".", 1)[1]
hits = []
for p in sorted(pathlib.Path(".").rglob("*.py")):
    if any(x in p.parts for x in (".mock", "__pycache__")):
        continue
    src = p.read_text()
    lines = src.splitlines()
    for n in ast.walk(ast.parse(src)):
        if isinstance(n, ast.ClassDef) and n.name == "Cache":
            for m in n.body:
                if isinstance(m, ast.FunctionDef) and m.name == meth:
                    hits.append((str(p), m.lineno))
        elif (isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute) and n.func.attr == meth):
            v = n.func.value
            name = v.id if isinstance(v, ast.Name) else v.attr if isinstance(v, ast.Attribute) else None
            if name in INSTANCES:
                hits.append((str(p), n.lineno))
for path, ln in sorted(set(hits)):
    print(f"{path}:{ln}: {pathlib.Path(path).read_text().splitlines()[ln-1].strip()}")
