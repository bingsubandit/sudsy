---
// Time on the benchmark corpus, Sudsy against the primary reference tool of the first languages of the
// support table (scripts/landing.mjs). The bar of the slower of the two is full; slower results of Sudsy stay in.
import { base } from '../../../config.mjs';
import { speedRows } from '../../../scripts/landing.mjs';
import { claimText } from '../../../scripts/speed.mjs';
const rows = speedRows();
const width = (v, r) => Math.max(1.5, (v / Math.max(r.sudsy, r.other)) * 100);
---
<section class="wrap" aria-labelledby="speed-title">
  <div class="sec-text wide">
    <h2 id="speed-title">Speed</h2>
    <p>Sudsy is <a href={`${base}/speed/`}>{claimText().replace(/^Faster/, 'faster')}</a>. Best of five wall-clock runs of the same task over the same files, a new process each time; a shorter bar is faster.</p>
  </div>
  <ul class="grid speed">
    {rows.map((r) => (
      <li class="speed-card">
        <div class="speed-head"><span>{r.language} · {r.task.toLowerCase()}</span><strong>{r.verdict}</strong></div>
        <div class="race">
          <span class="who">Sudsy</span>
          <span class="track"><span class="fill sudsy" style={`width:${width(r.sudsy, r)}%`}></span></span>
          <span class="time">{r.sudsyText}</span>
          <span class="who">{r.tool}</span>
          <span class="track"><span class="fill" style={`width:${width(r.other, r)}%`}></span></span>
          <span class="time">{r.otherText}</span>
        </div>
      </li>
    ))}
  </ul>
  <p class="more"><a href={`${base}/speed/`}>Every language with time and memory</a> · <a href="https://github.com/bingsubandit/sudsy/blob/main/docs/performance.md">Method</a></p>
</section>
